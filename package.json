{
  "name": "lecture-notes-desktop",
  "version": "0.3.1",
  "private": true,
  "description": "本地优先的听课笔记助手 Windows 桌面版",
  "author": "Lecture Notes",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run build && electron .",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node tests/smoke.cjs",
    "format": "prettier --write electron src tests docs README.md",
    "pack": "npm run build && electron-builder --win dir",
    "dist": "npm run build && electron-builder --win nsis",
    "test:tingwu": "node tests/tingwu-desktop.cjs",
    "test:study": "node tests/study-desktop.cjs",
    "test:audio": "node tests/audio-reliability.cjs"
  },
  "dependencies": {
    "@alicloud/openapi-core": "1.0.9",
    "@alicloud/tingwu20230930": "2.0.26",
    "@darabonba/typescript": "1.0.6",
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^5.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sherpa-onnx-node": "2.0.1",
    "sql.js": "^1.13.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "45.2.3",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  },
  "build": {
    "appId": "cn.lecturenotes.desktop",
    "productName": "听课笔记助手",
    "directories": {
      "output": "release-v0.3.1"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/*.wasm",
      "node_modules/sherpa-onnx-node/**/*",
      "node_modules/sherpa-onnx-win-x64/**/*"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "artifactName": "LectureNotes-Setup-${version}.${ext}"
  }
}
