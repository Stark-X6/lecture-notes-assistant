{
  "name": "lecture-notes-desktop",
  "version": "0.1.1",
  "private": true,
  "description": "本地优先的听课笔记助手 Windows 与 macOS 桌面版",
  "author": "Lecture Notes",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run build && electron .",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node tests/smoke.cjs",
    "test:tingwu": "node tests/tingwu-desktop.cjs",
    "format": "prettier --write electron src tests docs README.md",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test:mac": "node tests/macos-desktop.cjs",
    "pack:win": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win nsis",
    "pack:mac": "npm run build && electron-builder --mac --dir",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "dist:mac:x64": "npm run build && electron-builder --mac dmg zip --x64"
  },
  "dependencies": {
    "@alicloud/openapi-core": "1.0.9",
    "@alicloud/tingwu20230930": "2.0.26",
    "@darabonba/typescript": "1.0.6",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^5.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.13.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "45.2.3",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  },
  "build": {
    "appId": "cn.lecturenotes.desktop",
    "productName": "听课笔记助手",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/*.wasm"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "artifactName": "LectureNotes-Setup-${version}.${ext}",
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "LectureNotes-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": true,
      "notarize": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "用于录制课堂讲解并在本机保存音频；仅在课程授权后发送到语音转写服务。"
      }
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
